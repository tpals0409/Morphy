// Cloudflare Worker "morphy": the product page in web/ is static assets; src/index.js serves
// Mac and Windows downloads from the R2 bucket, using the D1 releases table to pick the current version.
{
  "name": "morphy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./web", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "morphy", "database_id": "5778d8dc-3d79-4ede-be37-ebe2ec1a769d" }
  ],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "morphy-releases" }],
  // PR previews read the same table and bucket; the Worker never writes to either.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "morphy", "database_id": "5778d8dc-3d79-4ede-be37-ebe2ec1a769d" }
    ],
    "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "morphy-releases" }]
  }
}
