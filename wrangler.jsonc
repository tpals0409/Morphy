// Cloudflare Worker "morphy": the product page and DMGs in web/ are static assets;
// src/index.js answers /download and /api/release from the D1 releases table.
{
  "name": "morphy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./web", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "morphy", "database_id": "5778d8dc-3d79-4ede-be37-ebe2ec1a769d" }
  ],
  // PR previews read the same releases table; the Worker only runs SELECTs on it.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "morphy", "database_id": "5778d8dc-3d79-4ede-be37-ebe2ec1a769d" }
    ]
  }
}
