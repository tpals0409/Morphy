// Cloudflare Worker "morphy": the product page in web/ is static assets; src/index.js serves
// Mac and Windows downloads from the R2 bucket (D1 releases picks the current version) and turns the
// contact form into GitHub issues. Secret: GITHUB_TOKEN (Issues: read and write on tpals0409/Morphy).
{
  "name": "morphy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./web", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "morphy", "database_id": "5778d8dc-3d79-4ede-be37-ebe2ec1a769d" }
  ],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "morphy-releases" }],
  // Contact form: 3 per minute per IP.
  "ratelimits": [{ "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  // PR previews read the same table and bucket. Without the GITHUB_TOKEN secret they can't file issues.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "morphy", "database_id": "5778d8dc-3d79-4ede-be37-ebe2ec1a769d" }
    ],
    "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "morphy-releases" }],
    "ratelimits": [{ "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
  }
}
